<%- include('partials/cabecera') %>
  <h1><%= titulo %></h1>
  <p class="total">Total: <%= libros.length %> libros</p>

  <% if (libros.length === 0) { %>
    <p class="vacio">No hay libros que mostrar</p>
  <% } else { %>
    <table>
      <tr>
        <th>Título</th>
        <th>Autor</th>
        <th>Año</th>
        <th>Estado</th>
      </tr>
      <% libros.forEach(libro => { %>
        <tr>
          <td>
            <%= libro.titulo %>
            <% if (libro.anio < 2000) { %>
              (clásico)
            <% } %>
          </td>
          <td><%= libro.autor %></td>
          <td><%= libro.anio %></td>
          <% if (libro.disponible) { %>
            <td class="disponible">Disponible</td>
          <% } else { %>
            <td class="prestado">Prestado</td>
          <% } %>
        </tr>
      <% }) %>
    </table>
  <% } %>
<%- include('partials/pie') %>
